# ── BigQuery ────────────────────────────────────────────────────────────────
# GCP project that holds the raw/core/ops/dash datasets.
BQ_PROJECT_ID=your-gcp-project
# Dataset location (all four datasets must share it).
BQ_LOCATION=US
# Dataset names (defaults shown; override only if they collide).
BQ_DATASET_RAW=raw
BQ_DATASET_CORE=core
BQ_DATASET_OPS=ops
BQ_DATASET_DASH=dash
# Path to a service-account key with BigQuery Data Editor + Job User.
# In GitHub Actions this file is written from the GCP_SERVICE_ACCOUNT_JSON secret.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-service-account.json

# ── Google Ads API (all required to pull Google Ads) ───────────────────────
# Developer token from the MCC API Center (needs Basic access approval).
GOOGLE_ADS_DEVELOPER_TOKEN=
# OAuth client (GCP console, OAuth client ID of type Desktop/Web).
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Long-lived refresh token minted by pipeline/auth/generate_google_refresh_token.py
GOOGLE_ADS_REFRESH_TOKEN=
# Manager (MCC) customer id, digits only, no dashes.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ── Meta Marketing API (all required to pull Meta) ─────────────────────────
META_APP_ID=
META_APP_SECRET=
# System-user token scoped ads_read (+ business_management).
META_ACCESS_TOKEN=

# ── ETL behavior ────────────────────────────────────────────────────────────
# Rolling re-pull window in days (today-N .. yesterday).
DEFAULT_LOOKBACK_DAYS=30
# QA alert thresholds (account currency units).
ALERT_SPEND_NO_CONV_MIN=150
ALERT_CPL_SPIKE_MULT=2.0
ALERT_STOPPED_MIN_DAILY=20
